# Virtual environment
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Output files
output/*.pdf
output/temp/

# Character-specific files (not for git)
data/character_data/
data/*_extracted.json
data/*_character_data*.json

# Ignore all source PDFs except committed class templates
data/source_pdfs/*
!data/source_pdfs/class_specific/
!data/source_pdfs/class_specific/*/
!data/source_pdfs/class_specific/*/*.pdf
!data/source_pdfs/generic/
!data/source_pdfs/generic/*.pdf

# Example outputs (generated, not committed)
examples/output_sheets/*.pdf

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
